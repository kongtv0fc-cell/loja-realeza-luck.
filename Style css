body {
  background-color: #0a0a2a;
  color: white;
  font-family: Arial, sans-serif;
  text-align: center;
}

h1 {
  margin: 20px;
  font-size: 28px;
  color: #00ffff;
}

.container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
}

.card {
  background: #1a1a3a;
  border-radius: 10px;
  padding: 20px;
  margin: 15px;
  width: 200px;
  text-align: center;
  box-shadow: 0 0 15px #00f;
  transition: transform 0.2s;
}

.card:hover {
  transform: scale(1.05);
}

.card .logo {
  width: 80px;
  margin-bottom: 10px;
}

button {
  background: #ff0066;
  color: white;
  border: none;
  padding: 10px;
  border-radius: 8px;
  cursor: pointer;
  margin-top: 10px;
}

button:hover {
  background: #ff3399;
}
